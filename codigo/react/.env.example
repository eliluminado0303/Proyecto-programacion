# Copia este archivo como ".env" (sin .example) y pega tus datos de Supabase.
# Son datos PÚBLICOS (van dentro de la página). NUNCA pongas aquí la clave "secret" ni "service_role".
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_KEY=pega_aqui_la_publishable_key_o_anon_key
# Correo del usuario administrador que creas en Supabase (Authentication > Users)
VITE_ADMIN_EMAIL=correo-del-administrador@ejemplo.com
# Webhook opcional de n8n para desarrollo local (en producción en Netlify usa /.netlify/functions/generar-video)
VITE_N8N_GENERAR_URL=http://localhost:5678/webhook/generar-video
# En Netlify (Environment variables) agrega GEMINI_API_KEY (secreta, sin prefijo VITE_) para la Netlify Function.
